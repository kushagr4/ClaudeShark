.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
submission.zip
*.pgn
scratch/

benchmarks/current/*.pgn

# Regenerable from the TWIC PGNs; the labelled file is a superset and is tracked.
corpus/candidates.jsonl

# derived feature cache for offline tuning; rebuilt by tools.tune.features
corpus/tune/*.npz

# Derived candidate engine directories, rebuilt by tools.tune.build_engines.
corpus/tune/engines/

# nohup stdout of long runs; the .txt/.json reports beside them are the record.
corpus/**/*.log

# Transient single-writer ownership records for experiment outputs.
*.jsonl.owner

# Test and JIT caches, editor and OS metadata.
.pytest_cache/
.numba_cache/
*.nbi
*.nbc
*.swp
*~
.DS_Store
Thumbs.db

# ClaudeShark's own rated-game records and the loss-autopsy game PGNs are project data,
# not build output: keep them trackable despite the *.pgn and corpus/**/*.log rules above.
!corpus/daily/round*.pgn
!corpus/daily/rca/round*.pgn
!corpus/daily/rcb/round*.pgn
!corpus/daily/logs/round*.log
!benchmarks/current/rcj_loss_autopsy/pgn/game-*.pgn
